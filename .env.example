# Copy to .env.local and adjust as needed

# Leave unset in dev: requests go to /client/v1 and Vite proxies them to the backend.
# Set an absolute URL only if the backend allows CORS for this origin (or in production).
# VITE_API_BASE_URL=http://localhost:8080/client/v1

# Backend the Vite dev server proxies /client to (read from the shell environment, not .env files)
# API_PROXY_TARGET=http://localhost:8080
